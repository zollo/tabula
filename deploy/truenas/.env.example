# ─────────────────────────────────────────────────────────────────────────
# Tabula — TrueNAS environment. Copy to `.env` next to docker-compose.yml.
# Generate strong secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Where persistent Postgres data lives. MUST be a real dataset path on your
# pool — change 'tank' to your pool name. Create it first (see README).
TABULA_DATA=/mnt/tank/apps/tabula

# Host port to expose the web UI (and /api) on.
TABULA_PORT=30082

# The URL people will use to reach Tabula.
TABULA_PUBLIC_URL=http://truenas.local:30082

# Image tag to run (latest, X.Y.Z, X.Y, or sha-<short>).
TABULA_TAG=latest

# --- Secrets ---
# SECRET_KEY is required (the stack refuses to start without it).
SECRET_KEY=
# Set before the first start; defaults to "tabula" (Postgres is internal-only).
POSTGRES_PASSWORD=
# Blank = a random password is generated and printed in the backend log once.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional overrides ---
POSTGRES_USER=tabula
POSTGRES_DB=tabula
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Initial value of the "allow sign-up" setting (admins can change it in the UI).
ALLOW_REGISTRATION=true

# --- Platform credentials (optional; admins can set these under Settings) ---
# X API v2 app bearer token (reading timelines needs a paid X API tier).
X_BEARER_TOKEN=
# Reddit "script" app from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Google sign-in (optional; off unless both are set) ---
# Google only accepts https redirect URIs on a public domain, so this needs
# TABULA_PUBLIC_URL to be an https URL (e.g. behind a reverse proxy or tunnel).
# Authorized redirect URI in Google Cloud: TABULA_PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
