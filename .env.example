# ─────────────────────────────────────────────────────────────
# Tabula environment configuration
# Copy to `.env` and fill in real values for local development.
# ─────────────────────────────────────────────────────────────

# --- Core ---
TABULA_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed by CORS (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# The URL people use to reach Tabula (used for Google sign-in redirects)
TABULA_PUBLIC_URL=http://localhost:8080

# --- Database ---
POSTGRES_USER=tabula
POSTGRES_PASSWORD=tabula
POSTGRES_DB=tabula
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by config.py, override if needed:
# DATABASE_URL=postgresql+asyncpg://tabula:tabula@postgres:5432/tabula

# --- Auth ---
# Session token lifetime for the web UI (API keys don't expire; revoke them instead)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# Initial value of the "allow sign-up" system setting (admins change it in the UI).
# Self-registered users still need an admin to enable them before they can track.
ALLOW_REGISTRATION=true

# --- Bootstrap admin (created on first startup if it does not exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# --- Google sign-in (optional; off unless both are set) ---
# OAuth "Web application" client from Google Cloud; see README "Google sign-in".
# Its authorized redirect URI must be TABULA_PUBLIC_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if Tabula is reached on a different URL than TABULA_PUBLIC_URL:
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Worker (Celery; Redis is only the broker) ---
REDIS_URL=redis://redis:6379/0
# How often the scheduler looks for accounts due for a scan
SCHEDULER_TICK_SECONDS=60
# Pages of history fetched per backfill task before it re-queues itself
BACKFILL_PAGES_PER_RUN=5

# --- Platform credentials (optional; admins can also set them under Settings) ---
# X API v2 app bearer token. Reading timelines needs a paid X API tier.
X_BEARER_TOKEN=
# Reddit "script" app from https://www.reddit.com/prefs/apps (app-only OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tabula/1.0 (archiver)
# Bluesky needs no credentials; this is its public AppView
BLUESKY_APPVIEW_URL=https://public.api.bsky.app

# --- Frontend (baked at build time) ---
# Leave EMPTY for same-origin: the frontend nginx proxies /api to the
# backend, so the SPA uses relative URLs and works behind any host. Only set this
# to an absolute URL when the API is served from a different origin.
VITE_API_BASE_URL=
